{
  "name": "racers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RACERS - design cars from real physical parameters, then race them together.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/ui_check.mjs",
    "desktop:typecheck": "tsc --noEmit -p electron/tsconfig.json",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "npm run build && node scripts/desktop-build.mjs",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "main": "dist-electron/main.js"
}
